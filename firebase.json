{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api", "function": { "functionId": "api", "region": "asia-east1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] },
      { "source": "/demo/**", "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }] }
    ]
  },
  "functions": { "source": "functions", "runtime": "nodejs20", "ignore": ["node_modules", ".git", "selftest.js"] },
  "firestore": { "rules": "firestore.rules" },
  "storage": { "rules": "storage.rules" },
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "storage": { "port": 9199 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
