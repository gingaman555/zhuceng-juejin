rules_version = '2';

/* 只收「新版」寫入的那一份規則（2026-09-29）。

   還開著舊版分頁的機器推的是整筆、而且不帶 v，會把別人交出去的
   狀態蓋回進行中（見 v2/src/41-sync.js 的 SYNC_V）。程式碼碰不到那些
   分頁，資料庫碰得到：新增與更新一律要帶 v = 2，形狀只能是 { j, v }。
   讀取照舊全開，所以舊分頁還看得到最新資料，只是寫不進去——
   有 9/23 之後版本的舊分頁，頂條會亮「還沒傳到雲端」。

   刪除照舊開著：清理腳本（cleanup-*.sh）要用，而且舊版本身不會亂刪。

   ── 2026-09-30 起這一份就是 firestore.rules ──

   node deploy.js 每次都會把這個檔案連同 hosting 一起推到兩個專案。
   9/30 先另存成獨立檔案，在 B 站與主站分別驗證過（REST 六項、真的
   Firebase 程式庫五項）才換進來，所以之後部署不會把版本檢查蓋回全開。

   規則剛部署要等約半分鐘才各處生效；量一次：node test-strict-rules.js <專案ID>。

   要退回全開（上課時出事的話）：
     npx firebase-tools deploy --only firestore:rules --config firebase.open.json --project <專案>
   全開那一份存在 firestore.open.rules。退回之後，下一次 node deploy.js
   會再把這一份推上去。

   寫入格式變了的時候：SYNC_V（v2/src/41-sync.js）與這裡的 2 一起加一。 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['j', 'v'])
        && request.resource.data.keys().hasAll(['j', 'v'])
        && request.resource.data.v == 2
        && request.resource.data.j is string;
      allow delete: if true;
    }
  }
}
