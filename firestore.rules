rules_version = '2';

/* 完全開放：知道網址的人都讀得到、寫得到。

   這是使用者在 2026-09-05 明確選的，我有先說過另外兩條路
   （匿名登入才讀得到／真的每人一組權限）以及這一條的代價：
   學生寫的省思、老師寫的那一句話，會放在一個只靠網址保護的地方。

   跟現在的登入強度是一致的——15-auth.js 自己寫著「這一版的密碼
   雜湊只擋肉眼，不是真的加密」。要收緊的話，最小的一步是打開
   匿名登入，然後把下面那一行換成 request.auth != null。 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
